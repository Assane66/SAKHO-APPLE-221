rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    // Default rule: deny all
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // Public product images: readable by all, writeable by admin
    match /products/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Banners: readable by all, writeable by admin
    match /banners/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Trade-in photos uploaded by users:
    // Allow upload if image size is less than 5MB and is an image type
    match /exchanges/{fileName} {
      allow create: if request.resource.size < 5 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*');
      allow read, delete: if isAdmin();
    }

    function isAdmin() {
      return request.auth != null &&
        firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)) &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == "admin";
    }
  }
}
