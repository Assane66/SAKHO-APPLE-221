rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // === UTILISATEURS ===
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // === PRODUITS ===
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // === VARIANTES DES PRODUITS ===
    match /products/{productId}/variants/{variantId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // === CATEGORIES ===
    match /categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // === COMMANDES ===
    match /orders/{orderId} {
      // Autoriser la création avec validation minimale des champs obligatoires
      allow create: if request.resource.data.customerName is string
                    && request.resource.data.customerName.size() >= 2
                    && request.resource.data.customerPhone is string
                    && request.resource.data.customerPhone.size() >= 9
                    && request.resource.data.items is list
                    && request.resource.data.items.size() > 0;
      allow read, update, delete: if isAdmin();
    }

    // === DEMANDES D'ÉCHANGE ===
    match /exchanges/{exchangeId} {
      allow create: if request.resource.data.contactPhone is string
                    && request.resource.data.contactPhone.size() >= 9
                    && request.resource.data.currentModel is string;
      allow read, update, delete: if isAdmin();
    }

    // === BANNIERES ===
    match /banners/{bannerId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // === PROMOTIONS ===
    match /promotions/{promoId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // === VENTES FLASH ===
    match /flashSales/{flashId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // === PARAMÈTRES DU SITE ===
    match /settings/{settingId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // === UTILITY FUNCTION ===
    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }
  }
}
